{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "allowSyntheticDefaultImports": true,
        "target": "es2022",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "paths": {
            "@client/*": ["../client/src/*"],
            "@server/*": ["./src/*"]
        },
        "esModuleInterop": true
    },
    "exclude": ["--*", "**/--*"],
    "include": ["./src/**/*.ts"]
}
